{
  "name": "vtt-offline",
  "version": "1.0.0",
  "description": "Tablero virtual de rol offline para máster y segunda pantalla de jugadores",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "dist:win": "tsc && vite build && electron-builder --win",
    "dist:mac": "tsc && vite build && electron-builder --mac",
    "test": "vitest run"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "pixi.js": "^8.7.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.vttoffline.app",
    "productName": "VTT Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
